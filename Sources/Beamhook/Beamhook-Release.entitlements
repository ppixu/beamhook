<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Release/distribution entitlements. Note: NO get-task-allow (that is
	     debug-only and is rejected by notarization). Hardened Runtime is on
	     (ENABLE_HARDENED_RUNTIME in project.yml), and this entitlement is what
	     lets the hardened app send Apple Events to control Spotify/Music/etc. -->
	<key>com.apple.security.automation.apple-events</key>
	<true/>
</dict>
</plist>
